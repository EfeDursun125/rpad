%YAML 1.2
---
name: RPad GLSL
file_extensions: [glsl, vert, frag, comp]
scope: source.rpad-glsl
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign
    - match: '//(?!\*).*$'
      scope: comment.line.double-slash
    - match: '/\*'
      scope: punctuation.definition.comment.begin
      push: block-comment
    - match: '\b(?:uniform|attribute|varying|in|out|flat|smooth|precise|if|else|return|break|continue|for|while|do|switch|case|default)\b'
      scope: keyword
    - match: '\b(?:vec[234]|mat[234]|sampler2D|sampler3D|samplerCube)\b'
      scope: storage.type
    - match: '\b(?:true|false|null)\b'
      scope: constant.language
    - match: '\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\d[\d_]*(?:\.[\d_]*)?(?:[eE][+-]?[\d_]+)?f?)\b'
      scope: constant.numeric
    - match: '"'
      scope: punctuation.definition.string.begin
      push: double-string
    - match: "'"
      scope: punctuation.definition.string.begin
      push: single-string
    - match: '\b[A-Za-z_]\w*(?=\s*\()'
      scope: entity.name.function
  block-comment:
    - meta_scope: comment.block
    - match: '\\.'
      scope: constant.character.escape
    - match: '\*/'
      scope: punctuation.definition.comment.end
      pop: true
  double-string:
    - meta_scope: string.quoted.double
    - match: '\\.'
      scope: constant.character.escape
    - match: '"|$'
      scope: punctuation.definition.string.end
      pop: true
  single-string:
    - meta_scope: string.quoted.single
    - match: '\\.'
      scope: constant.character.escape
    - match: "'|$"
      scope: punctuation.definition.string.end
      pop: true
