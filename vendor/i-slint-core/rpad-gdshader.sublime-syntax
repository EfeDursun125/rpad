%YAML 1.2
---
name: RPad GDShader
file_extensions: [gdshader]
scope: source.rpad-gdshader
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign
    - match: '//(?!\*).*$'
      scope: comment.line.double-slash
    - match: '/\*'
      scope: punctuation.definition.comment.begin
      push: block-comment
    - match: '\b(?:shader_type|render_mode|group_uniforms)\b'
      scope: keyword
    - match: '\b(?:uniform|varying|function|vertex|fragment|light|particles|emissive|glow)\b'
      scope: storage.type
    - match: '\b(?:if|else|return|break|continue|for|while)\b'
      scope: keyword.control
    - match: '\b(?:void|vec[234]|Vector[234]|float|int|bool|string|Color|Transform2D|Transform3D|Rect2i?)\b'
      scope: storage.type
    - match: '\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\d[\d_]*(?:\.[\d_]*)?(?:[eE][+-]?[\d_]+)?f?)\b'
      scope: constant.numeric
    - match: '"'
      scope: punctuation.definition.string.begin
      push: double-string
    - match: "'"
      scope: punctuation.definition.string.begin
      push: single-string
    - match: '\b[A-Za-z_]\w*(?=\s*\()'
      scope: entity.name.function
  block-comment:
    - meta_scope: comment.block
    - match: '\\.'
      scope: constant.character.escape
    - match: '\*/'
      scope: punctuation.definition.comment.end
      pop: true
  double-string:
    - meta_scope: string.quoted.double
    - match: '\\.'
      scope: constant.character.escape
    - match: '"|$'
      scope: punctuation.definition.string.end
      pop: true
  single-string:
    - meta_scope: string.quoted.single
    - match: '\\.'
      scope: constant.character.escape
    - match: "'|$"
      scope: punctuation.definition.string.end
      pop: true
